# Создаём долгоживущий JWT для ServiceAccount vault-auth
VAULT_AUTH_JWT=$(kubectl create token vault-auth -n hashicorp-vault-space --duration=0s)

# Адрес Kubernetes API
K8S_HOST="$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}')"

# CA-сертификат (в Yandex Cloud он обычно лежит в ConfigMap kube-root-ca.crt)
K8S_CA_CERT=$(kubectl get configmap kube-root-ca.crt -n kube-system -o jsonpath='{.data.ca\.crt}')

# Включаем метод аутентификации kubernetes (если ещё не включён) и конфигурируем его
kubectl exec -n hashicorp-vault-space vault-auth-0 -- sh -c "
  export VAULT_TOKEN='$VAULT_TOKEN'
  vault auth enable kubernetes 2>/dev/null || echo 'kubernetes auth already enabled'
  vault write auth/kubernetes/config \
    token_reviewer_jwt='$VAULT_AUTH_JWT' \
    kubernetes_host='$K8S_HOST' \
    kubernetes_ca_cert='$K8S_CA_CERT'
"


# Проверка
kubectl exec -n hashicorp-vault-space vault-auth-0 -- sh -c "
  export VAULT_TOKEN='$VAULT_TOKEN'
  vault read auth/kubernetes/config
"

# Ожидается увидеть поля kubernetes_host, kubernetes_ca_cert, token_reviewer_jwt.
